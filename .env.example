# Copie para .env e substitua todos os valores marcados antes de iniciar.
POSTGRES_DB=personaia
POSTGRES_DEV_PORT=5433
POSTGRES_MIGRATION_USER=personaia_migrator
POSTGRES_MIGRATION_PASSWORD=REPLACE_WITH_A_RANDOM_MIGRATION_PASSWORD
APP_DB_USER=personaia_runtime
APP_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_RUNTIME_PASSWORD
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_32_RANDOM_CHARACTERS
JWT_ISSUER=personaia-api
JWT_AUDIENCE=personaia-web
JWT_ACCESS_TTL=15m
SESSION_TTL_MINUTES=120
SUPER_ADMIN_EMAIL=admin@personaia.local
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
CORS_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
TRUST_PROXY=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
