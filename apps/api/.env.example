NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://personaia:change_me@postgres:5432/personaia?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ISSUER=personaia-api
JWT_AUDIENCE=personaia-web
JWT_ACCESS_TTL=15m
SESSION_TTL_MINUTES=120
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeThis1!
